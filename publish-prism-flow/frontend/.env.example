# Frontend → backend wiring for Growth Brother (FastAPI on port 8000)
#
# In dev, leaving these as the localhost defaults is fine; the Vite proxy in
# vite.config.js forwards /api/* → VITE_BACKEND_URL.
#
# In production, set all three to your deployed FastAPI base URL, e.g.
#   VITE_BACKEND_URL=https://api.your-domain.com
#   VITE_API_BASE_URL=https://api.your-domain.com
#   VITE_AI_CONTENT_AGENT_URL=https://api.your-domain.com

VITE_BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_AI_CONTENT_AGENT_URL=http://localhost:8000
