# ── App ─────────────────────────────────────────────────────────────
APP_ENV=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Comma-separated additional allowed origins for CORS (the URLs above are
# always allowed). Example: https://app.example.com,https://staging.example.com
CORS_ORIGINS=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# ── OpenAI (required for /repurpose/* and /api/v1/generate/*) ───────
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4o

# ── Google / YouTube OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LinkedIn OAuth ──────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Meta (Facebook + Instagram Business via Pages) ──────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# ── Instagram Login (direct) ────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
